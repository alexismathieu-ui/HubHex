# Copier vers .env.docker : cp .env.docker.example .env.docker
# Lancer : docker compose --env-file .env.docker up --build

# PostgreSQL (service db)
POSTGRES_USER=hubhex
POSTGRES_PASSWORD=changez_moi_en_production
POSTGRES_DB=hubhex
POSTGRES_PORT=5432

# Backend (obligatoire — generer : openssl rand -hex 32)
JWT_SECRET=remplacer_par_une_cle_aleatoire_de_32_caracteres_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
FRONTEND_URL=http://localhost:3000
ENABLE_RATE_LIMIT=true

# URL de l'API vue par le navigateur (build Next.js — arg Dockerfile)
# En local Docker : http://localhost:4000/api
# En prod derriere un domaine : https://api.votredomaine.fr/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Ports exposes sur la machine hote
BACKEND_PORT=4000
FRONTEND_PORT=3000

# SMTP (recommande en production pour reset mot de passe)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=HubHex <noreply@votredomaine.fr>
