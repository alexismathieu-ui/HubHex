NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hubhex
# Generer une cle aleatoire d'au moins 32 caracteres (openssl rand -hex 32). Ne jamais commiter le vrai .env.
JWT_SECRET=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum
FRONTEND_URL=http://localhost:3000
# true uniquement en local pour afficher le token de reset dans la reponse API (jamais en production).
ALLOW_DEV_RESET_TOKEN=false
# true = activer les rate limits en local (defaut: false, recommande pour le dev)
ENABLE_RATE_LIMIT=false

# SMTP (optionnel) — reset password par email en production
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=HubHex <noreply@hubhex.dev>
